#include <stdio.h>
int main() {
    int A[3][4], B[4][2], C[3][2] = {0};
    int i, j, k;
    printf("Enter 12 elements for A:");
    for(i=0;i<3;i++)
        for(j=0;j<4;j++)
            scanf("%d",&A[i][j]);
    printf("Enter 8 elements for B:");
    for(i=0;i<4;i++)
        for(j=0;j<2;j++)
            scanf("%d",&B[i][j]);
    for(i=0;i<3;i++)
        for(j=0;j<2;j++)
            for(k=0;k<4;k++)
                C[i][j] += A[i][k]*B[k][j];
    printf("Result:");
    for(i=0;i<3;i++){
        for(j=0;j<2;j++)
            printf("%d ",C[i][j]);
        printf("\n");
    }

    return 0;
}
